# Relative paths are resolved from backend/, not the terminal's current folder.
CAMPUSDINE_DB_PATH=data/campusdine.sqlite3

# Set false only for local HTTP development. Production must use HTTPS.
CAMPUSDINE_COOKIE_SECURE=false
CAMPUSDINE_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000

# Starting threshold; validate with actual counter lighting and student photos.
CAMPUSDINE_FACE_TOLERANCE=0.5
# Face-only login has no liveness detection; enable only for a controlled demo.
CAMPUSDINE_STUDENT_FACE_LOGIN=true

# Email is off until a real SMTP account is configured.
CAMPUSDINE_EMAIL_ENABLED=false
CAMPUSDINE_SMTP_HOST=
CAMPUSDINE_SMTP_PORT=587
CAMPUSDINE_SMTP_SECURITY=starttls
CAMPUSDINE_SMTP_USERNAME=
CAMPUSDINE_SMTP_PASSWORD=
CAMPUSDINE_EMAIL_FROM=
